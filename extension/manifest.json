{
  "manifest_version": 3,
  "name": "Obsidian Daily Logger",
  "version": "1.1.0",
  "description": "ChatGPT conversations are captured automatically for daily notes.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1:27123/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "web_accessible_resources": [{ "resources": ["capture-engine.js"], "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"] }],
  "action": { "default_popup": "popup.html", "default_title": "Obsidian Daily Logger" },
  "options_page": "recovery.html"
}
