{
  "manifest_version": 3,
  "name": "Obsidian Daily Logger",
  "version": "1.0.0",
  "description": "ChatGPTの会話と作業メモをローカルサービスへ記録します。",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*"], "js": ["content/index.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup/popup.html" },
  "options_page": "options/options.html"
}
